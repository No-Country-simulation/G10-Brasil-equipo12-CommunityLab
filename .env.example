# Provedor da LLM: groq (padrão), nvidia ou ollama
# LLM_PROVIDER=groq

GROQ_API_KEY=cole_sua_chave_aqui
# GROQ_MODEL=openai/gpt-oss-120b

# API da NVIDIA: gere a chave (começa com nvapi-) em https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-cole_sua_chave_aqui
# NVIDIA_MODEL=openai/gpt-oss-20b

# Modelo local via Ollama, sem chave de API
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_URL=http://127.0.0.1:11434
